{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/trontronicent/40k-assistant-plugins/main/schema/registry.schema.json",
  "title": "Strategicum STC Index",
  "description": "The list of published Strategicum plugins (STCs). The app downloads this file and clones each plugin from its own repository at the pinned commit.",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "updated",
    "plugins"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "author",
        "repo",
        "version",
        "tag",
        "commit",
        "kinds",
        "min_app_version",
        "plugin_api",
        "license"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$",
          "description": "Unique, never reused. Must equal the id in the plugin's strategicum-plugin.json."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "repo": {
          "type": "string",
          "pattern": "^https://[^\\s]+\\.git$",
          "description": "HTTPS clone URL of the plugin repository."
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Git tag of this version, usually v<version>."
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Full commit hash the tag points at. The app refuses a clone whose HEAD differs."
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "themes",
              "personas",
              "codex",
              "backend"
            ]
          }
        },
        "min_app_version": {
          "$ref": "#/$defs/semver"
        },
        "max_app_version": {
          "$ref": "#/$defs/semver"
        },
        "plugin_api": {
          "enum": [
            1,
            2
          ],
          "description": "1 = declarative only; 2 adds backend (code that runs inside the app)."
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "homepage": {
          "type": "string",
          "pattern": "^https://"
        },
        "tags": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,24}$"
          }
        },
        "yanked": {
          "type": "string",
          "minLength": 1,
          "description": "Reason. Hidden from Available; installed copies show a warning."
        },
        "deprecated": {
          "type": "string",
          "minLength": 1,
          "description": "Reason, shown next to the plugin."
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "read-game-files",
              "network"
            ]
          },
          "description": "Copied from the manifest's contributes.backend.permissions by registry_tool.py pin; shown before installing."
        }
      }
    }
  }
}
