{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/trontronicent/40k-assistant-plugins/main/schema/plugin-manifest.schema.json",
  "title": "Strategicum plugin manifest (strategicum-plugin.json)",
  "description": "Lives at the root of every plugin repository. Declares what the plugin contributes; plugin_api 1 allows declarative contributions only (no code).",
  "type": "object",
  "required": ["manifest_version", "id", "name", "version", "description", "author", "license", "app", "contributes"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "manifest_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 60},
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "description": {"type": "string", "minLength": 1, "maxLength": 300},
    "author": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://"}
      }
    },
    "license": {"type": "string", "minLength": 1},
    "app": {
      "type": "object",
      "required": ["min_version", "plugin_api"],
      "additionalProperties": false,
      "properties": {
        "min_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "max_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        "plugin_api": {"enum": [1]}
      }
    },
    "contributes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "themes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "path"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,38}[a-z0-9]$"},
              "path": {"$ref": "#/$defs/relpath", "description": "Folder holding theme.json and theme.css (preview.png optional)."}
            }
          }
        },
        "personas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "path"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,38}[a-z0-9]$"},
              "path": {"$ref": "#/$defs/relpath", "description": "A .json file with persona fields."}
            }
          }
        },
        "codex": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["library", "path"],
            "additionalProperties": false,
            "properties": {
              "library": {"type": "string", "pattern": "^[^_./\\\\:*?\"<>|][^/\\\\:*?\"<>|]{0,79}$"},
              "path": {"$ref": "#/$defs/relpath", "description": "Folder of Markdown files; subfolders become categories."}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "relpath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$))(?![A-Za-z]:)[^\\\\]+$"
    }
  }
}
