{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/trontronicent/40k-assistant-plugins/main/schema/plugin-manifest.schema.json",
  "title": "Strategicum plugin manifest (strategicum-plugin.json)",
  "description": "Lives at the root of every plugin repository. Declares what the plugin contributes. plugin_api 1: declarative contributions only; plugin_api 2 adds a backend (Python code run inside the app).",
  "type": "object",
  "required": [
    "manifest_version",
    "id",
    "name",
    "version",
    "description",
    "author",
    "license",
    "app",
    "contributes"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "manifest_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "author": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "app": {
      "type": "object",
      "required": [
        "min_version",
        "plugin_api"
      ],
      "additionalProperties": false,
      "properties": {
        "min_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "max_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "plugin_api": {
          "enum": [
            1,
            2
          ]
        }
      }
    },
    "contributes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "themes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,38}[a-z0-9]$"
              },
              "path": {
                "$ref": "#/$defs/relpath",
                "description": "Folder holding theme.json and theme.css (preview.png optional)."
              }
            }
          }
        },
        "personas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,38}[a-z0-9]$"
              },
              "path": {
                "$ref": "#/$defs/relpath",
                "description": "A .json file with persona fields."
              }
            }
          }
        },
        "codex": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "library",
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "library": {
                "type": "string",
                "pattern": "^[^_./\\\\:*?\"<>|][^/\\\\:*?\"<>|]{0,79}$"
              },
              "path": {
                "$ref": "#/$defs/relpath",
                "description": "Folder of Markdown files; subfolders become categories."
              }
            }
          }
        },
        "backend": {
          "type": "object",
          "required": [
            "module",
            "entry"
          ],
          "additionalProperties": false,
          "description": "plugin_api 2: a Python package imported by the app; entry(ctx) returns an object with start/stop/view/action.",
          "properties": {
            "module": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "entry": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "permissions": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "read-game-files",
                  "read-game-memory",
                  "network",
                  "write-codex"
                ]
              }
            },
            "python_requires": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "data_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000,
      "description": "Format version of the data the plugin stores in its data folder; raise it whenever that format changes. The app warns before installing a version whose data_version differs from the data already there (app 3.12.0+)."
    },
    "help": {
      "type": "string",
      "pattern": "^[^/\\\\].*\\.[mM][dD]$",
      "description": "Relative path of a Markdown help file (<= 100 KB), shown in the app's manual under Plugin Help (app 3.4.0+)."
    },
    "credits": {
      "type": "array",
      "maxItems": 30,
      "description": "Who made or contributed what; shown with the plugin's help (app 3.4.0+).",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "for": {
            "type": "string",
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 200
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$"
      },
      "description": "What the plugin is, for the STC Archive's category filter (app 3.13.0). The labels and the filter order come from the registry document's own `categories` vocabulary; an unlisted slug is shown title-cased."
    }
  },
  "$defs": {
    "relpath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![/\\\\])(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$))(?![A-Za-z]:)[^\\\\]+$"
    }
  }
}
